import os
import sys

import httpx

# Record what you did in your activity log through the gateway (log), then
# read the log back. The key decides which log: a key bound to an enrollment
# uses that enrollment's log, an unbound key your account's general log. Its
# service:log grant decides what it may do, e.g.
#   {"object": "service:log", "permissions": ["read", "write"],
#    "options": "log_level=info"}
# Entries below the grant's log_level are dropped (counted as "dropped").
{% if local_testing %}
# log is gateway-native (log://enrollment): there is no seller upstream to
# call in local mode, so this branch only confirms wiring.
print("log (skipped: gateway-native log://enrollment, no upstream)")
sys.exit(0)
{% else %}
headers = {"Authorization": f"Bearer {os.environ['UNITYSVC_API_KEY']}"}

written = httpx.post(
    "{{ service_base_url }}",
    headers=headers,
    json={"level": "info", "message": "Checked 214 listings, 3 matched", "attributes": {"checked": 214}},
)
if written.status_code == 403:
    # The key's policy holds no service:log grant with write.
    print(written.json())
    sys.exit(0)
written.raise_for_status()
print(written.json())  # {"accepted": 1, "dropped": 0, "entry_ids": [...]}

page = httpx.get("{{ service_base_url }}", headers=headers, params={"limit": 10})
if page.status_code == 403:
    # The grant holds write but not read.
    print(page.json())
    sys.exit(0)
page.raise_for_status()
for entry in page.json()["data"]:
    print(entry["created_at"], entry["level"], entry["message"])
{% endif %}
