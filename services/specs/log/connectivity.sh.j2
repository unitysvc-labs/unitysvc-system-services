#!/bin/bash
# Connectivity test for log's canonical interface — the gateway-native
# log://enrollment primitive (unitysvc/unitysvc#2670). There is NO seller
# upstream: the gateway forwards the request to the platform's log sink
# (POST /v1/internal/log), which records it against one of the caller's
# enrollments.
#
# The test identity has no enrollment that is "its own" to log for, and a
# test should not write to a real activity log anyway. So it posts a valid
# entry WITHOUT X-UnitySVC-Enrollment and expects the sink's own 400 naming
# that header. Only the platform's handler returns it, after the gateway
# routed /log to log://enrollment and the key was accepted for a customer, so
# a pass proves the whole path while writing nothing. A gateway 404 (no route)
# or 401 (key rejected) fails.
set -o pipefail

{% if local_testing %}
echo "connectivity ok (gateway-native log://enrollment, no upstream)"
{% else %}
URL="{{ service_base_url }}"

response=$(curl -sS --max-time 10 \
    -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
    -d '{"level":"info","message":"log connectivity probe"}' \
    -w "\n%{http_code}" \
    "$URL" 2>/dev/null)
status="${response##*$'\n'}"
body="${response%$'\n'*}"

if [ "$status" = "400" ] && printf '%s' "$body" | grep -q "X-UnitySVC-Enrollment"; then
    echo "connectivity ok — /log reached the platform's log sink (it asked for X-UnitySVC-Enrollment)"
    exit 0
fi
case "$status" in
  000) echo "connectivity failed: could not connect to $URL" >&2 ;;
  *)   echo "connectivity failed: expected the sink's 400 for a missing X-UnitySVC-Enrollment, got HTTP $status from $URL: ${body}" >&2 ;;
esac
exit 1
{% endif %}
