{% else %}
base_url = "{{ service_base_url }}".rstrip("/")
headers = {"Authorization": f"Bearer {k}"} if (k := os.environ.get("UNITYSVC_API_KEY")) else {}


def replace_category(resource: str, category: str, items: list[dict]) -> dict:
    """Replace a complete category; call explicitly only when you intend a write."""
    if resource not in {"intents", "preferences"}:
        raise ValueError("Choose intents or preferences")
    response = httpx.post(
        f"{base_url}/{resource}/{category}",
        headers=headers,
        json={"data": items},
        timeout=30,
    )
    response.raise_for_status()
    return response.json()  # Only {"name": category}; no stored data or version.


for resource in ("profile", "intents", "preferences"):
    response = httpx.get(f"{base_url}/{resource}", headers=headers, timeout=30)
    response.raise_for_status()
    values = response.json()[resource]
    print(f"{resource}: {values or '(nothing readable with this key)'}")

# To replace a category deliberately, call e.g.:
# replace_category("intents", "travel", [{"text": "Visit Japan next spring.", "public": False}])
# This replaces the entire list, including owner/other-app items. Service writes
# may preserve identical public records but cannot publish new/changed ones.
# Empty items clears the category. A 409 requires deliberate reconciliation.
