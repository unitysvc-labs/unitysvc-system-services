import os
import sys

import httpx

# The key's explicit service:me grant selects resources, e.g.
#   {"object": "service:me", "permissions": ["read", "write"],
#    "options": "profile=research&intents=travel&preferences=reading"}
# One permission set applies to all selections. Unset/unshared categories are
# absent; granted categories include private/public items and later additions.
