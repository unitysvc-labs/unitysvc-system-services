import os
import sys

import httpx

# Read parts of your UnitySVC profile through the gateway (me). Ask for the
# paths you want; every one comes back, with its value where the key's
# service:me grant covers it, e.g.
#   {"object": "service:me", "permissions": ["read"],
#    "options": "profile=research,address.state"}
# and null otherwise (not set, or not shared with this key: you can't tell).
# GET /me/profile/<path> asks for one path; /me is /me/profile.
{% if local_testing %}
# me is gateway-native (me://user): there is no seller upstream to call in
# local mode, so this branch only confirms wiring.
print("read (skipped: gateway-native me://user, no upstream)")
sys.exit(0)
{% else %}
response = httpx.get(
    "{{ service_base_url }}",
    params={"profile": "research,address.state"},
    headers={"Authorization": f"Bearer {k}"} if (k := os.environ.get("UNITYSVC_API_KEY")) else {},
)
response.raise_for_status()
for name, data in response.json()["profile"].items():
    print(f"{name}: {'(unspecified)' if data is None else data}")
{% endif %}
