#!/bin/bash
# Connectivity test for me's canonical interface: the gateway-native me://user
# scheme (unitysvc/apisix-gateways#77). There is NO seller upstream: the gateway
# answers a read itself from the caller's routing context: every path the
# caller asks for, valued where the key's service:me grant covers it and null
# otherwise. Any valid key gets the answer's shape, so this proves the route;
# the values depend on the test key's grant and profile.
set -o pipefail

{% if local_testing %}
echo "connectivity ok (gateway-native me://user, no upstream)"
{% else %}
URL="{{ service_base_url }}/profile?fields=research"

response=$(curl -sS --max-time 30 \
    -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
    -w "\n%{http_code}" \
    "$URL" 2>/dev/null)
status="${response##*$'\n'}"
body="${response%$'\n'*}"

case "$status" in
  2??) ;;
  000) echo "connectivity failed: could not connect to $URL" >&2; exit 1 ;;
  *)   echo "connectivity failed: HTTP $status from $URL: ${body}" >&2; exit 1 ;;
esac

if printf '%s' "$body" | grep -q '"profile"'; then
    echo "connectivity ok — /me answered with the requested profile paths"
    exit 0
fi
echo "connectivity failed: HTTP $status from $URL but no profile in the body: ${body}" >&2
exit 1
{% endif %}
